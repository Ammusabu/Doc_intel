# --- PostgreSQL ---
# Local Postgres.app (macOS):
#   DATABASE_URL=postgresql+asyncpg://YOUR_USER@localhost:5432/YOUR_DB
# Your local setup uses:
#   DATABASE_URL=postgresql+asyncpg://ammu@localhost:5432/doc_intel
# docker-compose (pgvector/pg16):
DATABASE_URL=postgresql+asyncpg://docintel:docintel@localhost:5433/docintel

# --- Groq (Phase 4) ---
GROQ_API_KEY=replace_me
GROQ_MODEL=openai/gpt-oss-20b

# --- Auth (Phase 3) ---
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Object storage (MinIO local) ---
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=docintel

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- ML model dir (Phase 2) ---
MODEL_DIR=./ml_models
